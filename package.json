{
  "name": "stress-match-game",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "An accessible word-stress matching game for English language learners.",
  "author": "Adam Leskis",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build && npm run format:check"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.6.1 <13"
  },
  "packageManager": "npm@11.6.1",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
